# PostgreSQL — configure les valeurs localement dans un fichier .env non versionné.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shy_db
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
# Option : DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/shy_db

# Générer une longue clé aléatoire et la garder secrète.
ADMIN_API_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
CORS_ORIGINS=http://localhost:3000
